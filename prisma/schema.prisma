// Prisma schema for shivrajput.com (ShivOS)
// Datasource URL lives in prisma.config.ts (Prisma 7 convention).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Blog posts — markdown body, optional cover image.
model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  imageUrl  String?
  body      String // markdown
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

/// Anonymous sticky notes left by visitors.
model VisitorNote {
  id        String   @id @default(cuid())
  author    String? // optional nickname
  body      String
  color     String   @default("butter")
  hidden    Boolean  @default(false) // moderation flag
  createdAt DateTime @default(now())

  @@index([hidden, createdAt])
}

/// Knowledge base Dobby (the AI agent) answers from.
/// One row per topic: key = "skills", content = the facts.
model ContextEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String?
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Portfolio projects — each one tells its own story as a timeline.
/// `stack` is a JSON string[] and `story` a JSON array of
/// { kind, title, body } items rendered as the case-file timeline.
model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  year      String
  summary   String
  detail    String
  image     String?
  live      String?
  github    String?
  stack     Json     @default("[]")
  story     Json     @default("[]")
  /// "advanced" | "intermediate" | "beginner" — which rail the card sits in.
  level     String   @default("intermediate")
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

/// Metric/skill tiles for the "by the numbers" app.
/// kind = "number" (229+ endpoints…) or "tech" (TypeScript…).
model Metric {
  id        String   @id @default(cuid())
  kind      String   @default("number")
  value     String
  label     String?
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, order])
}

/// Future YouTube videos.
model Video {
  id          String    @id @default(cuid())
  title       String
  url         String
  note        String?
  publishedAt DateTime?
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([published, order])
}

/// Key/value site configuration (dock visibility, github accounts, status
/// line…). Values are JSON strings.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Polaroids on the human-mode memory board. Image optional — caption-only
/// cards render as handwritten notes in a polaroid frame.
model Memory {
  id        String   @id @default(cuid())
  imageUrl  String?
  caption   String
  rotation  Float    @default(0)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

/// One visit (a browser tab's stay on the site). visitorId is a random id the
/// browser keeps in localStorage, so a returning visitor links up across
/// visits. No IP address is stored — location comes from Vercel's geo headers
/// and `org` (the network owner, e.g. "Google LLC") from an optional lookup.
model VisitSession {
  id         String       @id // generated by the browser
  visitorId  String
  startedAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  landing    String?
  referrer   String?
  source     String? // ?ref= or utm_source tag on the landing URL
  country    String?
  region     String?
  city       String?
  org        String?
  browser    String?
  os         String?
  device     String? // desktop | mobile | tablet
  screen     String?
  language   String?
  timezone   String?
  events     VisitEvent[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId])
}

/// Something a visitor did: pageview, app_open, resume_click, click…
model VisitEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  data      Json?
  at        DateTime     @default(now())

  @@index([sessionId, at])
  @@index([name, at])
}
